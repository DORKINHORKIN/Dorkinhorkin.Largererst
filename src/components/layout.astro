---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

const { title } = Astro.props;

import { getImage } from "astro:assets";

const bg = await import("../assets/illustration4.png").then(
  (mod) => mod.default,
);
const optimized = await getImage({
  src: bg,
  width: 500,
  height: 500,
  format: "webp",
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title && title + " | "} LARGEREST</title>
    <ClientRouter />
  </head>
  <body
    class="font-[lexend] bg-black text-white max-w-4xl mx-auto flex flex-col min-h-screen p-4"
  >
    <header class="h-40 flex flex-col justify-end">
      <a href="/">
        <h1 class="text-6xl font-black py-4 hover:underline">LARGEREST</h1>
      </a>
    </header>
    <img
      src={optimized.src}
      alt="Background"
      class="absolute inset-0 w-full h-full object-cover -z-1 blur-3xl opacity-50 transition-all duration-500"
      transition:persist
    />
    <main class="flex flex-col flex-1">
      <slot />
    </main>
    <footer
      class="h-20 flex items-center justify-center text-sm opacity-70 mt-10"
    >
      <p>&copy; {new Date().getFullYear()} LARGEREST. All rights reserved.</p>
    </footer>
  </body>
</html>
