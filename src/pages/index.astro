---
import Layout from "../components/layout.astro";

import Card from "../components/card.astro";

import { getCollection, render } from "astro:content";

const entries = await getCollection("projects");
const indexEntry = entries.find((entry) => entry.id === "index");
const indexContent = indexEntry ? await render(indexEntry) : null;
---

<Layout title={"LARGEREST"}>
  <div class="flex flex-col gap-4">
    <section>
      <div class="flex flex-col gap-3">
        <h2 class="text-2xl font-bold">
          {indexEntry?.data.title || "Projects"}
        </h2>
        {
          indexEntry?.data.description && (
            <p>{indexEntry.data.description}</p>
          )
        }
        {
          indexContent && (
            <div class="prose-invert prose text-white">
              <indexContent />
            </div>
          )
        }
      </div>

      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 gap-4"
      >
        {
          entries
            .filter((entry) => entry.id !== "index")
            .filter((entry) => !entry.data.draft)
            .map((entry) => (
              <Card
                tag="a"
                href={`/projects/${entry.id}/`}
                title={entry.data.title}
                description={entry.data.description}
                cover={entry.data.cover}
                className="[&:hover]:scale-120 [&:hover]:z-10 transition-transform "
              />
            ))
        }
      </div>
    </section>
  </div>
</Layout>
