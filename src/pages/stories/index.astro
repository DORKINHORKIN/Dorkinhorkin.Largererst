---
import Layout from "../../components/layout.astro";

---

<Layout title="LARGEREST - Stories">
  <section class="flex flex-col gap-6">
    <div class="flex items-center gap-2">
      <img
        src="https://static.fimfiction.net/images/emoticons/moustache.png"
        alt="Ponystuff"
        class="h-8 w-8 rounded-full"
      />
      <h2 class="text-2xl font-semibold">PONIES</h2>
    </div>
    <section>
      <div class="flex items-center gap-2 mb-4">
        <img
          src="https://placehold.co/48x48"
          alt="My Stories"
          class="h-8 w-8 rounded-full"
        />
        <h4 class="text-xl font-medium">My Stories</h4>
      </div>
      <ul
        class="flex flex-col gap-2 [&>li]:text-blue-500 [&>li]:hover:underline"
      >
        <li>
          <a href="">
            Spike’s Harem: Gabby, Smolder, Gilda, Ember, and Rarity.
          </a>
        </li>
        <li><a href=""> The Misadventures of Shape Shifter Dash </a></li>
        <li><a href=""> Anon and Harshy</a></li>
        <li><a href=""> The many green aliens of Ponyville </a></li>
        <li>
          <a href="">
            Duskshine is best pony! Also Eris (Fem Discord) is his wife.</a
          >
        </li>
      </ul>
    </section>
  </section>
</Layout>
